# PostgreSQL used by database/compose.yaml
PGPASS=replace-with-local-database-password
DATABASE_URL=postgres://postgres:replace-with-local-database-password@localhost:5432/userdb
# Use a separate database for integration tests that insert fixture rows.
TEST_DATABASE_URL=postgres://postgres:replace-with-local-database-password@localhost:5432/userdb_test

# Microsoft Entra app registration. Register the callback as a Web redirect URI.
MICROSOFT_TENANT_ID=replace-with-neu-entra-tenant-guid
MICROSOFT_CLIENT_ID=replace-with-application-client-id
MICROSOFT_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3100/api/auth/callback

# Optional: promote this NEU email to admin at startup.
ADMIN_EMAIL=
